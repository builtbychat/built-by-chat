{
  "name": "built-by-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Built by Chat — the internet decides, we build it live.",
  "license": "MIT",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @built-by-chat/web",
    "build": "npm run build -w @built-by-chat/shared && npm run build -w @built-by-chat/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test -w @built-by-chat/web",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "cf:types": "npm run cf:types -w @built-by-chat/web",
    "cf:dry-run": "npm run cf:dry-run -w @built-by-chat/web",
    "db:migrate:local": "npm run db:migrate:local -w @built-by-chat/web",
    "db:seed:local": "npm run db:seed:local -w @built-by-chat/web",
    "diagnose": "node scripts/diagnose.mjs",
    "status": "node scripts/status.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "prompt:validate": "node scripts/prompt-ops.mjs validate",
    "prompt:new": "node scripts/prompt-ops.mjs new",
    "episode:new": "node scripts/new-episode.mjs",
    "recording:prepare": "node scripts/recording.mjs prepare",
    "recording:verify": "node scripts/recording.mjs verify",
    "recording:remux": "node scripts/recording.mjs remux",
    "publishing:draft": "node scripts/publishing-draft.mjs",
    "patch-notes:draft": "node scripts/patch-notes.mjs",
    "overlay:health": "node scripts/overlay-health.mjs",
    "preview:verify": "node scripts/verify-preview.mjs",
    "db:restore": "bash scripts/restore-d1.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.1",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "engines": { "node": ">=22" }
}
