{
  "name": "tiny-signal-club",
  "version": "0.1.0",
  "private": true,
  "description": "Tiny Signal Club — small signals become big, strange things.",
  "license": "MIT",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @tiny-signal-club/web",
    "demo": "npm run demo -w @tiny-signal-club/web",
    "build": "npm run build -w @tiny-signal-club/shared && npm run build -w @tiny-signal-club/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test -w @tiny-signal-club/web",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run handoff:test && npm run brand:concept:test && npm run living:draft:test && npm run rehearsal:sim -- --runs=250 && npm run growth:status && npm run build",
    "cf:types": "npm run cf:types -w @tiny-signal-club/web",
    "cf:dry-run": "npm run cf:dry-run -w @tiny-signal-club/web",
    "db:migrate:local": "npm run db:migrate:local -w @tiny-signal-club/web",
    "db:seed:local": "npm run db:seed:local -w @tiny-signal-club/web",
    "diagnose": "node scripts/diagnose.mjs",
    "status": "node scripts/status.mjs",
    "growth:status": "node scripts/growth-status.mjs",
    "living:draft:test": "node scripts/test-living-drafts.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "prompt:validate": "node scripts/prompt-ops.mjs validate",
    "prompt:rehearse": "node scripts/prompt-rehearsal.mjs",
    "prompt:rehearse:record": "node scripts/prompt-rehearsal.mjs --record",
    "rehearsal:sim": "node scripts/rehearsal-sim.mjs",
    "rehearsal:sim:record": "node scripts/rehearsal-sim.mjs --runs=1000 --record",
    "prompt:new": "node scripts/prompt-ops.mjs new",
    "handoff": "node scripts/handoff-server.mjs",
    "handoff:status": "node scripts/read-handoff.mjs",
    "handoff:test": "node scripts/test-handoff.mjs",
    "brand:concept:test": "node scripts/test-brand-concepts.mjs",
    "brand:vectors:build": "python3 scripts/build-brand-vectors.py",
    "brand:templates:build": "python3 scripts/build-brand-templates.py",
    "brand:raster:export": "node scripts/export-brand-raster.mjs",
    "episode:new": "node scripts/new-episode.mjs",
    "recording:prepare": "node scripts/recording.mjs prepare",
    "recording:verify": "node scripts/recording.mjs verify",
    "recording:remux": "node scripts/recording.mjs remux",
    "publishing:draft": "node scripts/publishing-draft.mjs",
    "patch-notes:draft": "node scripts/patch-notes.mjs",
    "overlay:health": "node scripts/overlay-health.mjs",
    "obs:prepare": "node scripts/obs-install.mjs",
    "obs:install-local": "node scripts/obs-install.mjs --install",
    "preview:verify": "node scripts/verify-preview.mjs",
    "launch:preflight": "node scripts/launch-preflight.mjs --report",
    "launch:preflight:production": "node scripts/launch-preflight.mjs",
    "db:restore": "bash scripts/restore-d1.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.1",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "engines": { "node": ">=22" }
}
